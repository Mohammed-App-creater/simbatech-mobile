# Copy to .env.local to override (restart `npx expo start` afterwards).

# The site/API the app talks to. Default: the live site (https://simbatech-e-commerce.vercel.app),
# which proxies /api/* to the Django API. For a local API from the Android emulator use 10.0.2.2:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
